ce=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1060" y="560" width="300" height="230" as="geometry"/></mxCell><mxCell id="w-lgt" value="&lt;b&gt;Couleur = microservice propri&#233;taire&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="566" width="280" height="20" as="geometry"/></mxCell><mxCell id="w-sw0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1074" y="596" width="24" height="18" as="geometry"/></mxCell><mxCell id="w-swl0" value="MS1 &#183; assurance" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1106" y="592" width="240" height="26" as="geometry"/></mxCell><mxCell id="w-sw1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1074" y="628" width="24" height="18" as="geometry"/></mxCell><mxCell id="w-swl1" value="MS2 &#183; voyage" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1106" y="624" width="240" height="26" as="geometry"/></mxCell><mxCell id="w-sw2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1074" y="660" width="24" height="18" as="geometry"/></mxCell><mxCell id="w-swl2" value="MS3 &#183; r&#233;clamation" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1106" y="656" width="240" height="26" as="geometry"/></mxCell><mxCell id="w-sw3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1074" y="692" width="24" height="18" as="geometry"/></mxCell><mxCell id="w-swl3" value="MS4 &#183; indemnisation" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1106" y="688" width="240" height="26" as="geometry"/></mxCell><mxCell id="w-sw4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1074" y="724" width="24" height="18" as="geometry"/></mxCell><mxCell id="w-swl4" value="MS5 &#183; ai" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1106" y="720" width="240" height="26" as="geometry"/></mxCell><mxCell id="w-note" value="Une fois le monolithe d&#233;coup&#233; en microservices, toute association qui &lt;b&gt;traverse une couleur&lt;/b&gt; devient un simple &lt;b&gt;id&lt;/b&gt; (contractId, travelId, claimId, clientId) : il n'y a pas de cl&#233; &#233;trang&#232;re entre deux services." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1000" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="classes-par-domaine" id="classes-par-domaine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d-t" value="&lt;b style='font-size:16px'&gt;TravelGuard &#8212; diagramme de classes par domaine (1 bounded context = 1 microservice = 1 base)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;&#192; l'int&#233;rieur d'un domaine : vraies associations. Entre domaines : seulement des ids, lus via l'API du propri&#233;taire (OpenFeign) ou re&#231;us dans un &#233;v&#233;nement (RabbitMQ).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;f