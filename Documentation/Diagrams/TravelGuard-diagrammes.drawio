><mxPoint x="1400" y="480"/><mxPoint x="1400" y="860"/></Array></mxGeometry></mxCell><mxCell id="d-a2" value="ClaimApproved &#8594; indemnisation (async)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d-comp" target="d-claim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="780"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="communication-synchrone" id="communication-synchrone"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s-t" value="&lt;b style='font-size:16px'&gt;D&#233;clarer une r&#233;clamation &#8212; chemin synchrone (Gateway &#8594; Eureka &#8594; r&#233;clamation &#8594; assurance / voyage)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Le client (r&#244;le CLIENT) d&#233;clare un sinistre sur le contrat #12 depuis l'application.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="1400" height="46" as="geometry"/></mxCell><mxCell id="sl-cli" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Lina &#183; r&#244;le CLIENT&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-gw" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;:8080&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#1BA1E2;strokeColor=#006EAF;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-eur" value="&lt;b&gt;Eureka&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;:8761&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FAD7AC;strokeColor=#B46504;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-rec" value="&lt;b&gt;r&#233;clamation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MS3 &#183; :8083&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-assu" value="&lt;b&gt;assurance&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MS1 &#183; :8081&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-voy" value="&lt;b&gt;voyage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MS2 &#183; :8082&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-db" value="&lt;b&gt;reclamation_db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MongoDB&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="sl-mq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;travelguard.events&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FFF3E0;strokeColor=#FF6600;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="64" width="150" height="790" as="geometry"/></mxCell><mxCell id="s-act-gw" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="170" width="10" height="660" as="geometry"/></mxCell><mxCell id="s-act-rec" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="10" height="450" as="geometry"/></mxCell><mxCell id="s-n0" value="&lt;b&gt;0&lt;/b&gt; &#183; Au d&#233;marrage, chaque service s'enregistre dans Eureka (heartbeat 30 s) et garde une copie du registre." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="215" y="120" width="1250" height="30" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1&lt;/b&gt; &#183; POST /api/claims {contractId:12, travelId, type, montant} + Bearer JWT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="180" as="sourcePoint"/><mxPoint x="270" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt; &#183; v&#233;rifier le JWT (cl&#233;s Keycloak, r&#244;le CLIENT)&lt;br&gt;route /api/claims/** &#8594; lb://RECLAMATION" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="200" as="sourcePoint"/><mxPoint x="280" y="226" as="targetPoint"/><Array as="points"><mxPoint x="315" y="200"/><mxPoint x="315" y="226"/></Array></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;3&lt;/b&gt; &#183; o&#249; est RECLAMATION ?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="270" as="sourcePoint"/><mxPoint x="450" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4" value="instances (registre en cache)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="295" as="sourcePoint"/><mxPoint x="280" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;4&lt;/b&gt; &#183; relayer vers une instance (load balancing)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="340" as="sourcePoint"/><mxPoint x="630" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;5&lt;/b&gt; &#183; GET /api/contracts/12/coverage &lt;i&gt;(OpenFeign)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="400" as="sourcePoint"/><mxPoint x="810" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s7" value="200 : contrat actif, sinistre couvert (404 si inconnu)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="425" as="sourcePoint"/><mxPoint x="640" y="425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s8" value="&lt;b&gt;6&lt;/b&gt; &#183; GET /api/travels/{id} &lt;i&gt;(OpenFeign, infos voyage)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="470" as="sourcePoint"/><mxPoint x="990" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s9" value="200 : voyage valide pendant la p&#233;riode" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="495" as="sourcePoint"/><mxPoint x="640" y="495" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s10" value="&lt;b&gt;7&lt;/b&gt; &#183; r&#232;gles m&#233;tier : contrat actif ? montant &#8804; plafond ?" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="540" as="sourcePoint"/><mxPoint x="640" y="566" as="targetPoint"/><Array as="points"><mxPoint x="675" y="540"/><mxPoint x="675" y="566"/></Array></mxGeometry></mxCell><mxCell id="s11" value="&lt;b&gt;8&lt;/b&gt; &#183; INSERT claim (status SUBMITTED)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="610" as="sourcePoint"/><mxPoint x="1170" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s12" value="id = 45" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="635" as="sourcePoint"/><mxPoint x="640" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s13" value="&lt;b&gt;9&lt;/b&gt; &#183; publier &lt;i&gt;claim.created&lt;/i&gt; (n'attend pas)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="690" as="sourcePoint"/><mxPoint x="1350" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s14" value="&lt;b&gt;10&lt;/b&gt; &#183; 201 Created &#183; Location: /api/claims/45" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="750" as="sourcePoint"/><mxPoint x="280" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s15" value="201 Created + ClaimResponse" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="800" as="sourcePoint"/><mxPoint x="100" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s-err" value="&lt;b&gt;Cas d'erreur&lt;/b&gt;&lt;br&gt;&#8226; 401 / 403 au gateway : token manquant / mauvais r&#244;le&lt;br&gt;&#8226; 404 : contrat ou voyage introuvable (FeignException.NotFound)&lt;br&gt;&#8226; 409 : sinistre non couvert par le contrat&lt;br&gt;&#8226; 422 : montant demand&#233; sup&#233;rieur au plafond&lt;br&gt;&#8226; 503 : ASSURANCE ou VOYAGE indisponible (service arr&#234;t&#233;)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="700" height="120" as="geometry"/></mxCell><mxCell id="s-rem" value="&lt;b&gt;&#192; retenir&lt;/b&gt;&lt;br&gt;&#8226; Les &#233;tapes 1 &#8594; 10 sont &lt;b&gt;synchrones&lt;/b&gt; : le client attend chaque appel.&lt;br&gt;&#8226; Eureka est un &lt;b&gt;annuaire, pas un proxy&lt;/b&gt; : la requ&#234;te va directement &#224; l'instance choisie.&lt;br&gt;&#8226; r&#233;clamation ne stocke que &lt;b&gt;contractId / travelId / clientId&lt;/b&gt; : le reste est relu via ASSURANCE et VOYAGE.&lt;br&gt;&#8226; L'&#233;tape 9 d&#233;pose juste un message dans RabbitMQ : l'IA et l'indemnisation r&#233;agissent plus tard (page asynchrone)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="880" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="communication-asynchrone" id="communication-asynchrone"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ac-t" value="&lt;b style='font-size:16px'&gt;Communication asynchrone &#8212; RabbitMQ (exchange travelguard.events)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;r&#233;clamation publie les &#233;v&#233;nements ; l'IA et l'indemnisation r&#233;agissent plus tard, sans bloquer le client.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1380" height="46" as="geometry"/></mxCell><mxCell id="ac-broker" value="&lt;b&gt;RabbitMQ broker&lt;/b&gt; &#8212; Docker &lt;i&gt;rabbitmq:3-management&lt;/i&gt; &#183; AMQP :5672 &#183; management UI :15672" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF6600;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="820" height="640" as="geometry"/></mxCell><mxCell id="ac-prod" value="&lt;b&gt;MS3 &#183; r&#233;clamation&lt;/b&gt;&lt;br&gt;producer (Spring AMQP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="210" height="70" as="geometry"/></mxCell><mxCell id="ac-ex" value="&lt;b&gt;Exchange&lt;/b&gt;&lt;br&gt;&lt;b&gt;travelguard.events&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;topic &#183; durable&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.14;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="170" height="110" as="geometry"/></mxCell><mxCell id="ac-q-ai" value="&lt;b&gt;ai.claim-created&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="320" height="50" as="geometry"/></mxCell><mxCell id="ac-q-sc" value="&lt;b&gt;reclamation.claim-scored&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="320" height="50" as="geometry"/></mxCell><mxCell id="ac-q-ind" value="&lt;b&gt;indemnisation.claim-approved&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="320" height="50" as="geometry"/></mxCell><mxCell id="ac-dlx" value="&lt;b&gt;Exchange&lt;/b&gt;&lt;br&gt;&lt;b&gt;travelguard.events.dlx&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;direct&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.14;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="170" height="90" as="geometry"/></mxCell><mxCell id="ac-ai" value="&lt;b&gt;MS5 &#183; ai&lt;/b&gt;&lt;br&gt;consumer (FastAPI + aio-pika)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="158" width="230" height="60" as="geometry"/></mxCell><mxCell id="ac-recc" value="&lt;b&gt;MS3 &#183; r&#233;clamation&lt;/b&gt;&lt;br&gt;consumer (met &#224; jour le score)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="298" width="230" height="60" as="geometry"/></mxCell><mxCell id="ac-ind" value="&lt;b&gt;MS4 &#183; indemnisation&lt;/b&gt;&lt;br&gt;consumer (calcule le remboursement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="438" width="230" height="60" as="geometry"/></mxCell><mxCell id="ac-e1" value="&lt;b&gt;publie&lt;/b&gt;&lt;br&gt;claim.created / claim.approved" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-prod" target="ac-ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e2" value="binding &lt;i&gt;claim.created&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-ex" target="ac-q-ai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e3" value="binding &lt;i&gt;claim.scored&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-ex" target="ac-q-sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e4" value="binding &lt;i&gt;claim.approved&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-ex" target="ac-q-ind"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e5" value="deliver &#183; prefetch 10&lt;br&gt;ack manuel" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-q-ai" target="ac-ai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e6" value="deliver" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-q-sc" target="ac-recc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e7" value="deliver" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#2D7600;strokeWidth=2;fontColor=#2D7600;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ac-q-ind" target="ac-ind"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-e8" value="publie &lt;i&gt;claim.scored&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#B03A2E;fontColor=#B03A2E;strokeWidth=2;" edge="1" parent="1" source="ac-ai" target="ac-ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="120"/><mxPoint x="485" y="120"/></Array></mxGeometry></mxCell><mxCell id="ac-e9" value="reject / nack (requeue = false)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#B03A2E;fontColor=#B03A2E;strokeWidth=2;" edge="1" parent="1" source="ac-q-ai" target="ac-dlx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-dlq" value="&lt;b&gt;ai.claim-created.dlq&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B03A2E;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="240" height="50" as="geometry"/></mxCell><mxCell id="ac-e10" value="dead letters &#8594; inspection dans l'UI :15672" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;dashed=1;strokeColor=#B03A2E;strokeWidth=2;" edge="1" parent="1" source="ac-dlx" target="ac-dlq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac-json" value="{&lt;br&gt;&amp;nbsp; &quot;eventId&quot;: &quot;7b1e...&quot;,&lt;br&gt;&amp;nbsp; &quot;type&quot;: &quot;ClaimCreated&quot;,&lt;br&gt;&amp;nbsp; &quot;occurredAt&quot;: &quot;2026-11-08T20:15Z&quot;,&lt;br&gt;&amp;nbsp; &quot;claimId&quot;: 45,&lt;br&gt;&amp;nbsp; &quot;clientId&quot;: 7,&lt;br&gt;&amp;nbsp; &quot;contractId&quot;: 12,&lt;br&gt;&amp;nbsp; &quot;requestedAmount&quot;: 1500&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="230" height="180" as="geometry"/></mxCell><mxCell id="ac-jsonl" value="&lt;b&gt;Message (JSON)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="230" height="24" as="geometry"/></mxCell><mxCell id="ac-rules" value="&lt;b&gt;R&#232;gles de conception&lt;/b&gt;&lt;br&gt;&#8226; Le &lt;b&gt;producteur poss&#232;de l'exchange&lt;/b&gt; ; &lt;b&gt;chaque consommateur poss&#232;de sa queue&lt;/b&gt;.&lt;br&gt;&#8226; r&#233;clamation publie &lt;b&gt;apr&#232;s l'INSERT&lt;/b&gt; et n'attend jamais les consommateurs.&lt;br&gt;&#8226; ai : ack manuel, prefetch 10, &lt;b&gt;idempotent&lt;/b&gt; (m&#233;morise les eventIds d&#233;j&#224; trait&#233;s).&lt;br&gt;&#8226; Un message rejet&#233; part vers &lt;i&gt;travelguard.events.dlx&lt;/i&gt; &#8594; &lt;i&gt;...dlq&lt;/i&gt; au lieu d'&#234;tre perdu.&lt;br&gt;&#8226; Livraison &lt;b&gt;au moins une fois&lt;/b&gt; : le m&#234;me message peut arriver deux fois.&lt;br&gt;&#8226; Si l'IA est arr&#234;t&#233;e, les messages attendent dans sa queue : le client n'est pas affect&#233;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1380" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="securite-keycloak" id="securite-keycloak"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k-t" value="&lt;b style='font-size:16px'&gt;Keycloak &#8212; s&#233;curiser TravelGuard avec l'API Gateway (OAuth2 / OpenID Connect + JWT)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;L'application obtient un token aupr&#232;s de Keycloak ; le gateway le v&#233;rifie &#224; chaque requ&#234;te avant de router.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1240" height="46" as="geometry"/></mxCell><mxCell id="k-user" value="&lt;b&gt;Utilisateur + application&lt;/b&gt;&lt;br&gt;(Angular)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="k-kc" value="&lt;b&gt;Keycloak&lt;/b&gt; &#183; :8180&lt;br&gt;fournisseur d'identit&#233;&lt;br&gt;realm &lt;b&gt;travelguard&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAD7AC;strokeColor=#B46504;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="250" height="100" as="geometry"/></mxCell><mxCell id="k-gw" value="&lt;b&gt;API Gateway&lt;/b&gt; &#183; :8080&lt;br&gt;Spring Cloud Gateway&lt;br&gt;OAuth2 Resource Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1BA1E2;strokeColor=#006EAF;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="220" height="100" as="geometry"/></mxCell><mxCell id="k-ms" value="&lt;b&gt;MS3 &#183; r&#233;clamation&lt;/b&gt; &#183; :8083&lt;br&gt;&lt;span style='font-size:10px'&gt;(idem assurance, voyage, indemnisation, ai)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="240" height="100" as="geometry"/></mxCell><mxCell id="k-1" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;1&lt;/span&gt; login (Authorization Code + PKCE)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;" edge="1" parent="1" source="k-user" target="k-kc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="110"/></Array></mxGeometry></mxCell><mxCell id="k-2" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;2&lt;/span&gt; access token (JWT) + refresh token" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;" edge="1" parent="1" source="k-kc" target="k-user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="155"/></Array></mxGeometry></mxCell><mxCell id="k-3" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;3&lt;/span&gt; requ&#234;te + header Authorization: Bearer &amp;lt;JWT&amp;gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;" edge="1" parent="1" source="k-user" target="k-gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k-4" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;4&lt;/span&gt; cl&#233;s publiques (JWKS) &#8212; t&#233;l&#233;charg&#233;es une fois, en cache" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B46504;" edge="1" parent="1" source="k-gw" target="k-kc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k-6" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;6&lt;/span&gt; route lb://RECLAMATION (token transmis)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;" edge="1" parent="1" source="k-gw" target="k-ms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k-7" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;7&lt;/span&gt; r&#233;ponse" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;" edge="1" parent="1" source="k-ms" target="k-gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="410"/></Array></mxGeometry></mxCell><mxCell id="k-8" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;8&lt;/span&gt; r&#233;ponse (401 token absent/invalide &#183; 403 mauvais r&#244;le)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;" edge="1" parent="1" source="k-gw" target="k-user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="420"/></Array></mxGeometry></mxCell><mxCell id="k-5" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;5&lt;/span&gt; le gateway v&#233;rifie la &lt;b&gt;signature&lt;/b&gt;, l'expiration (&lt;i&gt;exp&lt;/i&gt;), l'&#233;metteur (&lt;i&gt;iss&lt;/i&gt;) et le &lt;b&gt;r&#244;le&lt;/b&gt; &#8212; sans appeler Keycloak &#224; chaque requ&#234;te." style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="452" width="270" height="70" as="geometry"/></mxCell><mxCell id="k-tok-l" value="&lt;b&gt;Access token (JWT) &#8212; payload d&#233;cod&#233;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="330" height="22" as="geometry"/></mxCell><mxCell id="k-tok" value="{&lt;br&gt;&amp;nbsp; &quot;iss&quot;: &quot;http://localhost:8180/realms/travelguard&quot;,&lt;br&gt;&amp;nbsp; &quot;preferred_username&quot;: &quot;lina&quot;,&lt;br&gt;&amp;nbsp; &quot;email&quot;: &quot;lina@example.com&quot;,&lt;br&gt;&amp;nbsp; &quot;realm_access&quot;: { &quot;roles&quot;: [&quot;CLIENT&quot;] },&lt;br&gt;&amp;nbsp; &quot;exp&quot;: 1792345678&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="360" height="160" as="geometry"/></mxCell><mxCell id="k-cfg-l" value="&lt;b&gt;Configuration Keycloak&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="560" width="380" height="22" as="geometry"/></mxCell><mxCell id="k-cfg" value="&#8226; Realm : &lt;b&gt;travelguard&lt;/b&gt;&lt;br&gt;&#8226; Client &lt;b&gt;travelguard-front&lt;/b&gt; : public, Authorization Code + PKCE&lt;br&gt;&#8226; R&#244;les realm : &lt;b&gt;ADMIN, CLIENT, GESTIONNAIRE, AGENT&lt;/b&gt;&lt;br&gt;&#8226; Utilisateurs : ex. lina &#8594; CLIENT&lt;br&gt;&#8226; Lanc&#233; dans Docker (port conteneur 8080 publi&#233; sur &lt;b&gt;8180&lt;/b&gt;, car le gateway utilise d&#233;j&#224; 8080)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="586" width="380" height="160" as="geometry"/></mxCell><mxCell id="k-gw-l" value="&lt;b&gt;C&#244;t&#233; gateway (exemple)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="560" width="420" height="22" as="geometry"/></mxCell><mxCell id="k-gwc" value="# application.yml&lt;br&gt;spring.security.oauth2.resourceserver.jwt.issuer-uri:&lt;br&gt;&amp;nbsp; http://localhost:8180/realms/travelguard&lt;br&gt;&lt;br&gt;// SecurityWebFilterChain&lt;br&gt;.pathMatchers(POST, &quot;/api/claims/**&quot;).hasRole(&quot;CLIENT&quot;)&lt;br&gt;.pathMatchers(POST, &quot;/api/contracts/**&quot;).hasRole(&quot;GESTIONNAIRE&quot;)&lt;br&gt;.pathMatchers(POST, &quot;/api/compensations/**&quot;).hasRole(&quot;AGENT&quot;)&lt;br&gt;.anyExchange().authenticated()" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="586" width="420" height="160" as="geometry"/></mxCell><mxCell id="k-foot" value="Seul le gateway est accessible de l'ext&#233;rieur : les microservices m&#233;tier restent dans le r&#233;seau priv&#233; (Docker) et ne manipulent jamais de mot de passe." style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1240" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>